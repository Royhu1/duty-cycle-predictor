# Copy this file to ".env" and fill in your API keys (the .env file is gitignored).
#
#   cp .env.example .env
#
# HERE Maps API key — required for route planning. https://developer.here.com/
HERE_API_KEY=your_here_api_key_here

# SRF platform API key — required for elevation data and logger-data download.
# Contact your data provider. Without it, elevation falls back to a flat profile.
SRF_API_KEY=your_srf_api_key_here
